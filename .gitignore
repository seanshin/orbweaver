# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Rust
target/

# Node
node_modules/
*.tsbuildinfo

# Generated IDL artifacts (build output, not the benchmark corpus)
generated/
!corpus/requirements/generated/
!corpus/requirements/generated/**
*.pyc
*_idl.py
*C.cpp
*C.h
*S.cpp
*S.h

# ORB runtime state
*.ior
omniORB.log
*.log
# …except the ones that are evidence rather than output. A recorded pipeline
# run IS the measurement for stages that cannot be re-run in the harness, and
# the end-to-end check refuses to pass without it. This is the third time a
# blanket ignore has swallowed a committed artefact (see spikes/tls/*.pem):
# the agent's gate passed on its own disk while the commit lost the file, and
# only CI, running from a fresh clone, could tell.
!spikes/e2e/recorded/*.log

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
# Test-only, self-originated TLS fixtures (see spikes/tls/README.md): these
# are not secrets — the CA key is deleted at generation and nothing trusts
# them outside our own tests — and the blanket *.pem rule above silently
# swallowed them out of a landed batch once already.
!spikes/tls/*.pem
!spikes/tls/*.key

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Phase 0 spike fixtures
spikes/echo.ior
spikes/*.log

# Claude Code local settings (machine-specific permission grants)
.claude/settings.local.json
spikes/server.ior

# JacORB interop fixture: downloaded jars and generated stubs
spikes/jacorb/lib/
spikes/jacorb/gen/
spikes/jacorb/classes/
spikes/jacorb.ior

# Agent worktrees (embedded checkouts, never part of the tree)
.claude/worktrees/
