// 27 — a declared bound in every place one can appear.
//
// A bound is part of the contract in both directions: a conformant peer may
// neither send more than it declared nor accept more than it declared. The
// static generated path used to drop every bound in this file — `rust_type`
// mapped `sequence<octet, 6>` to a bare `Vec<u8>` and the runtime wrote the
// length unchecked — while the dynamic path enforced them, which
// `docs/decisions/D006-plane-rule-tensor.md` §2 measured while arguing about
// something else.
//
// The placements here are deliberately one each, so a regression names itself:
// a bounded string, wstring and sequence as top-level typedefs; a bounded
// member inside a struct; a bounded element inside a bounded sequence and
// inside an unbounded one; a bounded field in an exception; a bounded
// parameter, return and attribute. `crates/orbweaver-gen/tests/bounds_oracle.rs`
// holds the static and dynamic paths to the same verdict over all of them,
// including the values that violate the bound — which is the case §8's
// equal-bytes rule can never generate, because a violating value has no bytes.
module gc27 {
  typedef string<8>            Tag;
  typedef wstring<4>           WideTag;
  typedef sequence<octet, 6>   Blob;
  typedef sequence<Tag, 3>     TagSeq;
  typedef sequence<Blob>       BlobSeq;

  struct Record {
    Tag     label;
    Blob    payload;
    WideTag wide;
  };

  exception TooBig {
    Tag  reason;
    Blob offending;
  };

  interface Ledger {
    // The two preconditions below say only what the typedefs above already
    // declare, and they are worth writing anyway for one measured reason: a
    // bound survives the type and does not survive every *rendering* of it.
    // `orbweaver-forge`'s `infer::render_type` prints `sequence<Tag>` for
    // `TagSeq` and `string` for `Tag`, so a reader shown the signature alone —
    // an agent composing a call against the ingested shape — is shown a
    // contract with no bounds in it at all. The header above notes that a
    // violating value has no bytes; these lines are where a caller finds that
    // out before it writes one.
    //@ ai_precond: key is at most 8 characters, entry.label at most 8, entry.payload at most 6 octets and entry.wide at most 4 characters — every one a declared bound, and a value over it cannot be marshalled at all
    //@ ai_example: key "ledger-1" is exactly at the 8-character bound and is accepted; "ledger-01" is nine characters and has no encoding
    Record keep(in Tag key, in Record entry) raises (TooBig);
    //@ ai_precond: batch itself is unbounded, but each element is a Blob and so is at most 6 octets
    TagSeq digest(in BlobSeq batch);
    attribute Tag title;
  };
};
