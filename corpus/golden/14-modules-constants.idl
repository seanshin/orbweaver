// 14 — nested modules, reopened modules, constants of several types.
module gc14 {
  const long    MAX_RETRIES = 3;
  const double  EPSILON     = 0.0001;
  const string  VERSION     = "1.2";
  const boolean STRICT      = TRUE;
  module inner {
    const long OFFSET = MAX_RETRIES * 2;
    struct Point { long x; long y; };
  };
};
module gc14 {  // reopened
  interface Extra { inner::Point origin(); };
};
