// 22 — operations returning interfaces (Expert delegate), oneway, and a
// sequence of object references (ExpertSeq) as a return type — none of which
// 01–21 combine. Adopted from a real external design, docs/CORBAMoEArchitecture.md
// §7, after the two corrections in PLAN-MOE §1 (Context → CallContext,
// residency → state); the original defects are corpus/negative/n11 and n12.
// Parameters the document named `e` are `ex` here: gen-corpus binds its
// encoder closure argument as `e`, and this batch's compile oracle caught the
// generated stub shadowing it (`e.put(e)`) — a generator hygiene bug, filed
// A parameter literally named `e` is kept ON PURPOSE: it pins the generator
// hygiene fix (generated locals are __-prefixed so no IDL name can shadow them).
module moe {

  typedef sequence<octet> Tensor;      // reference-carrying; never inlined
  typedef string          CapabilityId;

  enum Residency { OFFLOADED, PREFETCHING, RESIDENT, ACTIVE };

  struct Activation { Tensor data; string dtype; string shape; };
  struct CallContext    { string request_id; string trace_id; unsigned long step; };

  struct Capability {
    CapabilityId id;
    float        cost;
    float        latency_p99_ms;
    float        load;
    Residency    state;
    unsigned long long mem_footprint;
    float        route_freq;
    string       placement_node;
    string       contract_version;
  };

  struct GateSignal  { Tensor affinity; unsigned short top_k; };
  struct Constraints { CapabilityId required; float max_latency_ms; float max_cost; };

  // v1.1 — ADDITIVE. `Capability` is released and is not edited in place:
  // adding `specialization` and `latency_p50_ms` to it is BREAKING by our own
  // idl-diff (a CDR member has no tag and no length, so an added one is read
  // as part of whatever followed it — PLAN-MOE §4.5, measured). The two
  // properties the trading matcher could not answer for a wire-registered
  // offer travel in a new struct that *composes* the released one, through
  // new operations below. corpus/evolution/moe/v1.0 is the frozen release
  // this file is diffed against; corpus/evolution/moe/v1.1-in-place is the
  // edit that was refused.
  struct MeasuredCapability {
    Capability base;
    string     specialization;     // what the expert is for: math, code, vision, …
    float      latency_p50_ms;     // measured, never a placeholder — an unmeasured
  };                               // expert registers through v1.0 and stays unranked

  //@ ai_desc: An expert weight block or submodel, addressable and loadable
  interface Expert {
    //@ ai_desc: The capability contract this expert registers under
    //@ ai_effect: read_only
    Capability describe();
    Activation process(in Activation x, in CallContext ctx);
    //@ ai_effect: read_only
    //@ ai_authz: moe.expert.delegate
    Expert     delegate(in Capability need);
  };
  typedef sequence<Expert> ExpertSeq;

  //@ ai_desc: Control-plane gate: selects and dispatches to experts
  interface Router {
    // ACCEPTED LIMIT, not a hazard to be fixed later: this hands back a whole
    // sequence of dialable experts, so a caller learns where every candidate
    // runs. D037, approved 2026-08-31, option C — a named floor under D029
    // §6.1's Location row.
    //
    // The reason is a reason and not an intention. Closing it needs
    // `Router::dispatch` to be the only way through, which this project has
    // declined to serve on separate grounds (D006 option E), and that refusal
    // is a different decision from this one. The candidate that merely narrows
    // the exposure buys displacement, which D035 already ruled is not closure.
    //
    // What is NOT the question, per D037 §2: whether a caller may know *which*
    // experts exist. It may — this interface is a control-plane gate and a gate
    // whose callers cannot is not a gate. What does not carry across is
    // ADDRESSES: load state has two contract homes where it is a value a caller
    // asks for, and an address has none, so learning it is not being told, it
    // is reading a fact off the marshalled form of something given for another
    // purpose.
    //
    // `crates/orbweaver-trading/tests/a_selection_hands_back_addresses.rs`
    // asserts this floor rather than describing it, so the day somebody proxies
    // these references the row moves deliberately instead of quietly.
    //
    // *받아들인 한계이지 나중에 고칠 위험이 아니다. 닫으려면 `Router::dispatch`가
    // 필요하고 그 거절은 별개의 결정이며, 좁히는 후보는 D035가 이미 폐쇄가
    // 아니라고 판정한 변위를 살 뿐이다. 질문은 어떤 전문가가 있는지 알아도 되는가가
    // 아니다 — 그건 알아도 된다. 건너가지 않는 것은 **주소**다.*
    //@ ai_effect: read_only
    //@ ai_authz: moe.router.select
    ExpertSeq  select(in GateSignal g, in Constraints qos);
    Activation dispatch(in Activation x, in CallContext ctx);
  };

  //@ ai_desc: Offer registry the trading service reads
  interface ExpertRegistry {
    //@ ai_effect: destructive
    //@ ai_authz: moe.registry.write
    void register_expert(in Expert e, in Capability cap);
    //@ ai_effect: destructive
    //@ ai_authz: moe.registry.write
    void deregister(in Expert e);
    //@ ai_effect: idempotent
    //@ ai_authz: moe.registry.write
    void heartbeat(in Expert e, in Capability updated_cap);
    // v1.1 (server-first, not breaking): the same two operations over the
    // measured shape. A v1.0 client keeps calling the two above and its
    // offers stay unanswerable on the two new properties, which is the truth.
    //@ ai_desc: Register an expert whose specialization and median latency were measured
    //@ ai_effect: destructive
    //@ ai_authz: moe.registry.write
    void register_measured(in Expert e, in MeasuredCapability measured);
    //@ ai_desc: Re-announce an expert with a fresh measurement
    //@ ai_effect: idempotent
    //@ ai_authz: moe.registry.write
    void heartbeat_measured(in Expert e, in MeasuredCapability updated_measured);
  };

  //@ ai_desc: POA-backed loader: residency transitions, never per token
  interface ExpertLoader {
    //@ ai_effect: idempotent
    //@ ai_authz: moe.loader.residency
    oneway void prefetch(in CapabilityId id);
    // Evicting a resident expert is destructive to everything routed to it,
    // and the name carries no verb the checker's heuristic recognises — the
    // annotation is the only thing that says so.
    //@ ai_effect: destructive
    //@ ai_authz: moe.loader.residency
    void  evict(in CapabilityId id);
    //@ ai_effect: idempotent
    //@ ai_authz: moe.loader.residency
    void  pin(in CapabilityId id);
    //@ ai_effect: read_only
    Residency status(in CapabilityId id);
  };
};
