// 19 — a service shaped like real legacy code, not a type-system exercise.
// The one golden file that says which SIDL it is written to. The marker is a
// comment to omniidl and every other compiler; contract-check reads it
// (contract/unknown-sidl-version, absent here) and S3's gate reads it. It sits
// above the module, whose annotations the registry does not keep — which is
// the point: it is read from the syntax tree, not the registry.
//@ sidl_version: 1
module tms {
  enum TrackClass { UNKNOWN, SURFACE, AIR, SUBSURFACE };
  struct Position { double lat; double lon; double alt; };
  struct Track {
    long        id;
    TrackClass  klass;
    Position    pos;
    double      course;
    double      speed;
    string      designation;
  };
  typedef sequence<Track> TrackSeq;
  exception NoSuchTrack { long id; };
  exception Overloaded  { long retry_after_ms; };
  interface TrackManager {
    //@ ai_effect: read_only
    TrackSeq  snapshot();
    //@ ai_effect: read_only
    Track     get(in long id) raises (NoSuchTrack);
    //@ ai_effect: destructive
    //@ ai_authz: tms.track.write
    long      create(in Track t) raises (Overloaded);
    //@ ai_effect: idempotent
    //@ ai_authz: tms.track.write
    void      update(in Track t) raises (NoSuchTrack);
    // Deletion behind a oneway: no reply, so no way to learn it failed. If
    // any operation in this file deserves its own scope, it is this one.
    //@ ai_effect: destructive
    //@ ai_authz: tms.track.delete
    oneway void drop(in long id);
    readonly attribute long count;
  };
};
