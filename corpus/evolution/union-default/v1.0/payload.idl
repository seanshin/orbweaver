// ---------------------------------------------------------------------------
// FROZEN: the released contract of the union-default §5.3 pair.
//
// One union with a labelled case and a `default:` member. This file is the
// *released* half of two diffs:
//   idl-diff union-default/v1.0/payload.idl union-default/v1.0-default-first/payload.idl
//     -> exit 0, "no change" — the same union with the default written first:
//        a value is a discriminator and the one member it selects, so the
//        member list's order is not on the wire
//   idl-diff union-default/v1.0/payload.idl union-default/v1.1-retyped-default/payload.idl
//     -> exit 1 — a case inserted ahead of the default AND the default's type
//        changed. Until 2026-08-19 the differ compared union members by
//        position and reported only the inserted case; the retyped default was
//        missed. Do not edit this file.
//
// 동결: union-default §5.3 쌍의 릴리스 쪽. default를 앞에 쓴 같은 유니언과는
// "변경 없음"(exit 0), default 앞에 case를 끼워 넣고 default의 타입을 바꾼
// 리비전과는 exit 1이어야 한다. 위치로 비교하던 차분기는 후자에서 끼워 넣은
// case만 보고하고 타입 변경을 놓쳤다. 수정하지 않는다.
// ---------------------------------------------------------------------------

module evo {
  union Payload switch (long) {
    case 1: long code;
    default: string text;
  };

  //@ ai_desc: Accepts one payload, whichever branch it carries
  interface Sink {
    //@ ai_desc: Deliver one payload
    //@ ai_effect: idempotent
    void put(in Payload item);
  };
};
