// returns `Posting`; both are declared next door, and neither name exists in
// this file's text.
//
// 이 파일은 v2와 바이트까지 동일하다.  변경은 전부 `common.idl`에 있다.
// ---------------------------------------------------------------------------

#include "common.idl"

#pragma prefix "orbweaver.example"

module Ledger {

    interface Journal : Recorded {
        Posting fetch(in Reference slip);
    };

};
